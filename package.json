{
  "name": "phoenikbot",
  "version": "1.0.0",
  "description": "Advanced Discord Bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/clean-dts.js",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "deploy": "ts-node src/bot/deploy-commands.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload phoenikbot",
    "pm2:stop": "pm2 stop phoenikbot"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "html-to-text": "^9.0.5",
    "moment": "^2.30.1",
    "mongoose": "^8.3.1",
    "ms": "^2.1.3",
    "node-cron": "^3.0.3",
    "openai": "^4.47.1",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "rss-parser": "^3.13.0",
    "uuid": "^9.0.1",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.16",
    "@types/passport-discord": "^0.1.11",
    "@types/uuid": "^9.0.8",
    "@types/xml2js": "^0.4.14",
  }
}
